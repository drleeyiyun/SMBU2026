# Copy to `.env` for Docker Compose: `cp .env.example .env`
#
# Inside Compose, API uses hostname `db`. On your machine (PowerShell / pnpm db:migrate), Postgres is
# reachable only if the `db` service publishes a port — see docker-compose.yml (default 5433→5432).
# Use a second line in practice: keep DATABASE_URL for Docker as below, and override when running CLI
# on the host, e.g.:
#   $env:DATABASE_URL="postgresql://postgres:postgres@localhost:5433/campus"; pnpm db:migrate
# Or set in `.env` to localhost:5433 if you only develop on the host with `docker compose up -d db`.
#
# For a Postgres installed directly on Windows (not Docker), use its port, often 5432:
# postgresql://USER:PASSWORD@localhost:5432/campus

DATABASE_URL=postgresql://postgres:postgres@db:5432/campus

# API — minimum 16 characters in app validation; use >=32 in production
JWT_SECRET=please_replace_with_a_secret_at_least_32_chars_long

PORT=3000

# Browser origin for the SPA (nginx on host). Used by API CORS when set.
CORS_ORIGIN=http://localhost:8080

# Optional: compose port mappings (see docker-compose.yml)
WEB_PORT=8080
API_PORT=3000

# School timetable integration mode: mock | http
SCHOOL_API_MODE=mock
