# Copy to `.env` for Docker Compose: `cp .env.example .env`
#
# DATABASE_URL — used on your machine by `pnpm db:migrate` / `pnpm db:seed` (reads repo-root `.env`).
# With Docker DB, use the **host-mapped** port (default 15432). `api` in docker-compose.yml overrides
# this with `...@db:5432` inside containers, so the stack still connects correctly.
#
# If you set DB_PUBLISH_PORT, use that port instead of 15432 here.
# For Postgres installed on the host (not Docker), use its URL, e.g. postgresql://USER:PASS@localhost:5432/campus

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/campus

# API — minimum 16 characters in app validation; use >=32 in production
JWT_SECRET=please_replace_with_a_secret_at_least_32_chars_long

PORT=3000

# Browser origin for the SPA (nginx on host). Used by API CORS when set.
CORS_ORIGIN=http://localhost:8080

# Optional: compose port mappings (see docker-compose.yml)
WEB_PORT=8080
API_PORT=3000

# School timetable integration mode: mock | http
SCHOOL_API_MODE=mock

# --- Docker Hub unreachable (timeout to auth.docker.io): pull via a mirror. Compose passes these into builds / db image.
# DaoCloud public mirror (confirm current address in their docs). Uncomment and `docker compose pull` / `up --build`:
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# Never set these to empty (e.g. NGINX_IMAGE=); omit the line or Docker gets a blank FROM.
