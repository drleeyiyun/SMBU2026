{
  "name": "campus-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter api test",
    "db:generate": "npx --yes pnpm@9.15.0 --filter db generate",
    "db:migrate": "npx --yes pnpm@9.15.0 --filter db migrate",
    "db:seed": "npx --yes pnpm@9.15.0 --filter db seed",
    "lint": "pnpm -r lint"
  }
}
